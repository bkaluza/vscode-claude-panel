{
  "name": "claude-session-panel",
  "displayName": "Session Panel for Claude Code",
  "description": "A panel for your Claude Code terminal sessions: see what's running, open several at once in named, coloured terminals, and reopen them after a restart.",
  "version": "0.12.0",
  "publisher": "bkaluza",
  "author": {
    "name": "Bostjan Kaluza"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1A1C24",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bkaluza/vscode-claude-panel.git"
  },
  "bugs": {
    "url": "https://github.com/bkaluza/vscode-claude-panel/issues"
  },
  "homepage": "https://github.com/bkaluza/vscode-claude-panel#readme",
  "keywords": [
    "claude",
    "claude code",
    "sessions",
    "terminal",
    "ai",
    "agents"
  ],
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode the panel works, but the workspace can't change the command that starts Claude Code, its extra arguments, or switch on --dangerously-skip-permissions: those settings are only read from your user settings.",
      "restrictedConfigurations": [
        "claudeSessions.command",
        "claudeSessions.extraArgs",
        "claudeSessions.skipPermissions"
      ]
    },
    "virtualWorkspaces": false
  },
  "main": "./extension.js",
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "colors": [
      {
        "id": "claudeSessions.red",
        "description": "Claude Code's red session colour (/color red).",
        "defaults": { "dark": "#DC2626", "light": "#DC2626", "highContrast": "#DC2626", "highContrastLight": "#DC2626" }
      },
      {
        "id": "claudeSessions.orange",
        "description": "Claude Code's orange session colour (/color orange).",
        "defaults": { "dark": "#D97757", "light": "#D97757", "highContrast": "#D97757", "highContrastLight": "#D97757" }
      },
      {
        "id": "claudeSessions.yellow",
        "description": "Claude Code's yellow session colour (/color yellow).",
        "defaults": { "dark": "#CA8A04", "light": "#CA8A04", "highContrast": "#CA8A04", "highContrastLight": "#CA8A04" }
      },
      {
        "id": "claudeSessions.green",
        "description": "Claude Code's green session colour (/color green).",
        "defaults": { "dark": "#16A34A", "light": "#16A34A", "highContrast": "#16A34A", "highContrastLight": "#16A34A" }
      },
      {
        "id": "claudeSessions.cyan",
        "description": "Claude Code's cyan session colour (/color cyan).",
        "defaults": { "dark": "#0891B2", "light": "#0891B2", "highContrast": "#0891B2", "highContrastLight": "#0891B2" }
      },
      {
        "id": "claudeSessions.blue",
        "description": "Claude Code's blue session colour (/color blue).",
        "defaults": { "dark": "#6A9BCC", "light": "#6A9BCC", "highContrast": "#6A9BCC", "highContrastLight": "#6A9BCC" }
      },
      {
        "id": "claudeSessions.purple",
        "description": "Claude Code's purple session colour (/color purple).",
        "defaults": { "dark": "#827DBD", "light": "#827DBD", "highContrast": "#827DBD", "highContrastLight": "#827DBD" }
      },
      {
        "id": "claudeSessions.pink",
        "description": "Claude Code's pink session colour (/color pink).",
        "defaults": { "dark": "#C46686", "light": "#C46686", "highContrast": "#C46686", "highContrastLight": "#C46686" }
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "claudeSessions",
          "title": "Session Panel",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "claudeSessions": [
        {
          "type": "webview",
          "id": "claudeSessions.panel",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeSessions.resume",
        "title": "Resume Sessions…",
        "category": "Session Panel",
        "icon": "$(history)"
      },
      {
        "command": "claudeSessions.new",
        "title": "New Session…",
        "category": "Session Panel",
        "icon": "$(add)"
      },
      {
        "command": "claudeSessions.openViewer",
        "title": "Open Read-only View…",
        "category": "Session Panel",
        "icon": "$(eye)"
      },
      {
        "command": "claudeSessions.restore",
        "title": "Reopen Last Sessions",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.toggleSkipPermissions",
        "title": "Toggle Skip Permissions",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.showPanel",
        "title": "Show Panel",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.moveToSplit",
        "title": "Move Open Sessions to the Right Editor Group",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.enableSlotKeysInTerminal",
        "title": "Enable Shortcuts in Terminals",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus1",
        "title": "Switch to Open Session 1",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus2",
        "title": "Switch to Open Session 2",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus3",
        "title": "Switch to Open Session 3",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus4",
        "title": "Switch to Open Session 4",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus5",
        "title": "Switch to Open Session 5",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus6",
        "title": "Switch to Open Session 6",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus7",
        "title": "Switch to Open Session 7",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus8",
        "title": "Switch to Open Session 8",
        "category": "Session Panel"
      },
      {
        "command": "claudeSessions.focus9",
        "title": "Switch to Open Session 9",
        "category": "Session Panel"
      }
    ],
    "keybindings": [
      {
        "command": "claudeSessions.resume",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "claudeSessions.showPanel",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
      },
      {
        "command": "claudeSessions.new",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "terminalFocus || focusedView == 'claudeSessions.panel'"
      },
      {
        "command": "claudeSessions.focus1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      },
      {
        "command": "claudeSessions.focus9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "config.claudeSessions.sessionShortcuts && (terminalFocus || focusedView == 'claudeSessions.panel')"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "claudeSessions.resume",
          "when": "view == terminal",
          "group": "navigation@90"
        },
        {
          "command": "claudeSessions.new",
          "when": "view == terminal",
          "group": "navigation@91"
        }
      ]
    },
    "configuration": {
      "title": "Session Panel",
      "properties": {
        "claudeSessions.skipPermissions": {
          "type": "boolean",
          "default": false,
          "description": "Start sessions with --dangerously-skip-permissions. Also toggled from the panel."
        },
        "claudeSessions.command": {
          "type": "string",
          "default": "claude",
          "description": "Command that starts Claude Code."
        },
        "claudeSessions.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra arguments added to every launch."
        },
        "claudeSessions.includeSubfolders": {
          "type": "boolean",
          "default": true,
          "description": "Also list sessions started in subfolders of the workspace."
        },
        "claudeSessions.terminalLocation": {
          "type": "string",
          "enum": [
            "split",
            "editor",
            "panel"
          ],
          "enumDescriptions": [
            "Editor tabs in the right-hand editor group; files stay in the left one.",
            "Editor tabs in the current editor group.",
            "The terminal panel."
          ],
          "default": "panel",
          "description": "Where session terminals open."
        },
        "claudeSessions.sessionShortcuts": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Cmd+1 … Cmd+9 (Ctrl on Windows/Linux) switch to open session 1–9 while a terminal or the panel has focus. To work in terminals they need to be in `#terminal.integrated.commandsToSkipShell#`: the extension asks once, or run **Session Panel: Enable Cmd+1–9 in Terminals**."
        },
        "claudeSessions.restoreOnStartup": {
          "type": "string",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "default": "ask",
          "description": "Reopen the sessions that were open when the window last closed."
        },
        "claudeSessions.notifyWhenDone": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a session finishes working while you're looking at something else."
        },
        "claudeSessions.maxRecent": {
          "type": "number",
          "default": 100,
          "description": "How many past sessions the panel lists."
        },
        "claudeSessions.elsewhereIdleHours": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "A session running elsewhere (another window, a terminal outside VS Code, the Claude desktop app) that has been idle this many hours leaves \"Running elsewhere\" and is listed by day with the others, still marked as running. 0 = keep them all under \"Running elsewhere\"."
        },
        "claudeSessions.showResults": {
          "type": "boolean",
          "default": true,
          "description": "List what each session handed you on its card: artifacts and docs it published, pull and merge requests it opened, files it sent you and plans you approved."
        },
        "claudeSessions.contextWindow": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Context window size in tokens for the usage bar on each session. 0 = auto (1M for current models and [1m] variants, 200K for Claude 3/4)."
        }
      }
    }
  }
}
